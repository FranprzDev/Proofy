    "/webhooks/github": {
      "post": {
        "summary": "Github Webhook",
        "description": "Stub: valida firma y parsea `workflow_run`. No llama a GitHub ni al grafo todav\u00eda.",
        "operationId": "github_webhook_webhooks_github_post",
        "parameters": [
          {
            "name": "x-hub-signature-256",
            "in": "header",
            "required": false,
            "schema": {
