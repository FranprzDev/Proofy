  "components": {
    "schemas": {
      "Ambiguity": {
        "properties": {
          "clause": {
            "type": "string",
            "title": "Clause"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "suggested_question": {
            "type": "string",
            "title": "Suggested Question"
          }
        },
        "type": "object",
        "required": [
          "clause",
          "reason",
          "suggested_question"
        ],
        "title": "Ambiguity"
      },
      "CicdInput": {
        "properties": {
          "expected": {
            "$ref": "#/components/schemas/Ref"
          },
          "evidence_ref": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ScenarioResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "expected"
        ],
        "title": "CicdInput"
      },
      "CicdState": {
        "properties": {
          "expected": {
            "$ref": "#/components/schemas/Ref"
          },
          "evidence_ref": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Ref"
              },
              {
                "type": "null"
              }
            ]
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/ScenarioResult"
            },
            "type": "array",
            "title": "Results"
          },
          "analysis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Verdict"
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Verdict"
              },
              {
                "type": "null"
              }
            ]
          },
          "attestation_authorized": {
            "type": "boolean",
            "title": "Attestation Authorized",
            "default": false
          },
          "observations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Observations"
          }
        },
        "type": "object",
        "required": [
          "expected"
        ],
        "title": "CicdState"
      },
      "DocumentInput": {
        "properties": {
          "contract_id": {
            "type": "string",
            "title": "Contract Id"
          },
          "document": {
            "type": "string",
            "title": "Document"
          },
          "answers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Answers"
          }
        },
        "type": "object",
        "required": [
          "contract_id",
          "document"
        ],
        "title": "DocumentInput"
      },
      "DocumentState": {
        "properties": {
          "contract_id": {
            "type": "string",
            "title": "Contract Id"
          },
          "document": {
            "type": "string",
            "title": "Document"
          },
          "answers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Answers"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus",
            "default": "pending"
          },
          "clauses": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Clauses"
          },
          "ambiguities": {
            "items": {
              "$ref": "#/components/schemas/Ambiguity"
            },
            "type": "array",
            "title": "Ambiguities"
          },
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/Scenario"
            },
            "type": "array",
            "title": "Scenarios"
          },
          "pending_items": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Pending Items"
          },
          "accepted_by_client": {
            "type": "boolean",
            "title": "Accepted By Client",
            "default": false
          },
          "accepted_by_provider": {
            "type": "boolean",
            "title": "Accepted By Provider",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "contract_id",
          "document"
        ],
        "title": "DocumentState"
      },
      "DocumentStatus": {
        "type": "string",
        "enum": [
          "pending",
          "needs_clarification",
          "proposal"
        ],
        "title": "DocumentStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Ref": {
        "properties": {
          "milestone_id": {
            "type": "string",
            "title": "Milestone Id"
          },
          "contract_version": {
            "type": "string",
            "title": "Contract Version"
          },
          "revision": {
            "type": "string",
            "title": "Revision"
          }
        },
        "type": "object",
        "required": [
          "milestone_id",
          "contract_version",
          "revision"
        ],
        "title": "Ref",
        "description": "Identifies what is evaluated against: milestone, agreed version and exact revision."
      },
      "Scenario": {
        "properties": {
          "clause": {
            "type": "string",
            "title": "Clause"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "expected_result": {
            "type": "string",
            "title": "Expected Result"
          }
        },
        "type": "object",
        "required": [
          "clause",
          "description",
          "expected_result"
        ],
        "title": "Scenario"
      },
      "ScenarioResult": {
        "properties": {
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id"
          },
          "status": {
            "$ref": "#/components/schemas/ScenarioStatus"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "scenario_id",
          "status"
        ],
        "title": "ScenarioResult"
      },
      "ScenarioStatus": {
        "type": "string",
        "enum": [
          "passed",
          "failed",
          "skipped",
          "error"
        ],
        "title": "ScenarioStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Verdict": {
        "type": "string",
        "enum": [
          "favorable",
          "needs_fix",
          "inconclusive"
        ],
        "title": "Verdict"
      }
    }
  }
}