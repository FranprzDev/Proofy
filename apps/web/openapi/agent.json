    "/webhooks/github": {
      "post": {
        "summary": "Github Webhook",
        "description": "Stub: validates the signature and parses `workflow_run`. No GitHub/graph call yet.",
        "operationId": "github_webhook_webhooks_github_post",
        "parameters": [
          {
            "name": "x-hub-signature-256",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
