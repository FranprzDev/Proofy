# Server-only: never use the NEXT_PUBLIC_ prefix with these values.
AGENT_API_URL=http://localhost:8000
AGENT_API_KEY=
# HMAC secret for session/nonce cookies (>= 32 chars). Auth fails closed without it. e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Optional: expected SIWS domain (defaults to the request Host header).
SIWS_DOMAIN=
# Attestor keypair that signs release_milestone: base58 secret key or JSON array of 64 bytes. Devnet only.
ATTESTOR_SECRET_KEY=

# Public (devnet by default; mainnet is not supported).
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_ESCROW_PROGRAM_ID=95W1tXhcMnCPXqUqrxpBp1P6aBwhoXjvzr6nnK62JzMN
