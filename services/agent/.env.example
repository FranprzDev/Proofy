LLM_ENABLED=false
LLM_MODEL=google_genai:gemini-3.8-flash
LLM_TEMPERATURE=0
GOOGLE_API_KEY=
CHECKPOINTER=memory
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
GRAPH_RECURSION_LIMIT=25
LOG_LEVEL=INFO
AGENT_API_KEY=
GITHUB_WEBHOOK_SECRET=
# GitHub App manifest (used to create the app at https://github.com/settings/apps/new)
GITHUB_APP_NAME=Proofy CI
GITHUB_APP_DESCRIPTION=Verifica entregas y libera pagos por hitos en Solana.
GITHUB_APP_HOMEPAGE_URL=http://localhost:3000
GITHUB_APP_WEBHOOK_URL=http://localhost:8000/webhooks/github
GITHUB_APP_CALLBACK_URL=http://localhost:8000/github/callback
GITHUB_APP_PUBLIC=false
AGENT_MAX_ITERATIONS=40
# TesterArmy project the test designer explores and validates against (repo e2e/).
E2E_PROJECT_DIR=../../e2e
E2E_ALLOW_RUN=false
E2E_CLI_TIMEOUT_S=300
